EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 온통청년 오픈API 인증키. 서버(sync 스크립트)에서만 사용 — EXPO_PUBLIC_ 접두사 붙이지 말 것
YOUTHCENTER_API_KEY=

# Supabase service_role 시크릿 키(Supabase 대시보드 > Settings > API > Secret keys에서 발급).
# RLS를 전부 우회하는 관리자급 키라서 서버 전용 동기화 스크립트에서만 쓰고, 절대 앱 코드/
# EXPO_PUBLIC_ 접두사로 쓰면 안 됨. 유출되면 즉시 Supabase 대시보드에서 폐기(revoke) 후 재발급할 것.
SUPABASE_SERVICE_ROLE_KEY=
